# Copy to .env and edit; run.sh reads it. Every value is optional.

# --- Server ----------------------------------------------------------------
# Interface to bind. 127.0.0.1 keeps the app on this computer.
CLICKWHEEL_HOST=127.0.0.1
CLICKWHEEL_PORT=8765
# Host names the server answers to, comma-separated.
CLICKWHEEL_ALLOWED_HOSTS=127.0.0.1,localhost
# Where jobs are processed. Empty means <system temp>/clickwheel.
CLICKWHEEL_WORK_DIR=

# --- Jobs ------------------------------------------------------------------
# Jobs running at once, and parallel ffmpeg encodes inside one job.
CLICKWHEEL_MAX_JOBS=2
CLICKWHEEL_ENCODE_WORKERS=4
# Longest video accepted, in minutes (720 = 12 hours).
CLICKWHEEL_MAX_DURATION_MIN=720
# Minutes a finished file stays downloadable before the server deletes it.
CLICKWHEEL_FILE_TTL_MIN=60
# Genre tag written to every track. Leave empty for none.
CLICKWHEEL_GENRE=Lo-Fi
# Open the browser on start (1 or 0).
CLICKWHEEL_OPEN_BROWSER=1
